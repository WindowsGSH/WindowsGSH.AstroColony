{
  "id": "astro-colony",
  "name": "Astro Colony Dedicated Server",
  "version": "1.1.1",
  "author": "Shenniko",
  "description": "WindowsGSH module for installing, configuring, and running an Astro Colony dedicated server.",
  "url": "https://github.com/WindowsGSH/WindowsGSH.AstroColony",
  "homepage": "https://github.com/WindowsGSH/WindowsGSH.AstroColony",
  "repository": "https://github.com/WindowsGSH/WindowsGSH.AstroColony",
  "sourceUrl": "https://github.com/WindowsGSH/WindowsGSH.AstroColony",
  "color": "#1E8449",
  "moduleApiVersion": "1.0",
  "minimumWindowsGshVersion": "0.1.0",
  "type": "csharp",
  "entry": "WindowsGSH.Modules.AstroColony.AstroColonyModule",
  "steam": { "appId": "2662210", "anonymous": true, "validate": true },
  "entryPoints": {
    "start": "AstroColony\\Binaries\\Win64\\AstroColonyServer.exe",
    "processName": "AstroColonyServer"
  },
  "runtime": {
    "allowsEmbeddedConsole": true,
    "portIncrements": 1,
    "queryProtocol": "process",
    "defaultArguments": "-SteamServerName={quote:server.name} -port={network.port} -QueryPort={network.queryPort} -log {server.additionalArguments}",
    "stop": { "strategy": "closeWindow", "waitMilliseconds": 10000, "killAfterTimeout": true }
  },
  "capabilities": { "directConnection": true },
  "configFields": [
    { "key": "server.name", "label": "Server Name", "type": "Text", "defaultValue": "Astro Colony Dedicated Server", "required": true, "group": "Server" },
    { "key": "server.password", "label": "Server Password", "type": "Password", "defaultValue": "", "group": "Server" },
    { "key": "server.mapName", "label": "World / Map Name", "type": "Text", "defaultValue": "Astro Colony", "required": true, "group": "Server" },
    { "key": "server.seed", "label": "World Seed", "type": "Text", "defaultValue": "", "group": "Server", "description": "Leave empty to let the module generate a seed when the setting is first written." },
    { "key": "server.maxPlayers", "label": "Max Players", "type": "Number", "defaultValue": 20, "minimum": 1, "maximum": 100, "group": "Server" },
    { "key": "server.loadLatestSave", "label": "Load Latest Save", "type": "Boolean", "defaultValue": true, "group": "Saves" },
    { "key": "server.adminIds", "label": "Administrator Steam IDs", "type": "Text", "defaultValue": "", "group": "Administration", "description": "Comma-separated Steam IDs." },
    { "key": "game.sharedTechnologies", "label": "Shared Technologies", "type": "Boolean", "defaultValue": true, "group": "Gameplay" },
    { "key": "game.oxygenConsumption", "label": "Oxygen Consumption", "type": "Boolean", "defaultValue": true, "group": "Gameplay" },
    { "key": "game.freeConstruction", "label": "Free Construction", "type": "Boolean", "defaultValue": false, "group": "Gameplay" },
    { "key": "game.sandbox", "label": "Sandbox", "type": "Boolean", "defaultValue": false, "group": "Gameplay" },
    { "key": "server.autosaveInterval", "label": "Autosave Interval (minutes)", "type": "Number", "defaultValue": 5, "minimum": 1, "maximum": 1440, "group": "Saves" },
    { "key": "server.autosaveCount", "label": "Autosaves Retained", "type": "Number", "defaultValue": 10, "minimum": 1, "maximum": 100, "group": "Saves" },
    { "key": "network.port", "label": "Game Port", "type": "Port", "defaultValue": 7777, "required": true, "minimum": 1, "maximum": 65535, "group": "Network" },
    { "key": "network.queryPort", "label": "Steam Query Port", "type": "Port", "defaultValue": 27015, "required": true, "minimum": 1, "maximum": 65535, "group": "Network" },
    { "key": "server.additionalArguments", "label": "Additional Arguments", "type": "CommandLine", "defaultValue": "", "group": "Launch" }
  ],
  "ports": [
    { "id": "game", "name": "Game Port", "protocol": "udp", "configField": "network.port", "required": true },
    { "id": "query", "name": "Steam Query Port", "protocol": "udp", "configField": "network.queryPort" }
  ],
  "backupTargets": [
    { "key": "saved", "label": "Worlds, Configuration, and Logs", "path": "AstroColony\\Saved", "type": "directory", "required": true }
  ],
  "addons": []
}
